{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ULTRA Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/src/**/*.js"
      ],
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
