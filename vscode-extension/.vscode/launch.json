{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ULTRA Extension Development Host (Local)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/src/**/*.js"
      ],
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
