Screen {
    background: #000000;
    layout: vertical;
}

/* ── HEADER ──────────────────────────────────────────────────────────────── */

UltraHeader {
    height: 3;
    background: #0a0a0a;
    border-bottom: solid #1f1f1f;
    content-align: center middle;
}

#header-text {
    color: #ffffff;
    text-style: bold;
}

/* ── MODE BAR ────────────────────────────────────────────────────────────── */

ModeBar {
    height: 1;
    background: #0d0d0d;
    color: #444444;
    border-bottom: solid #1a1a1a;
}

/* ── SESSION SETUP ───────────────────────────────────────────────────────── */

SessionSetup {
    height: 1fr;
    background: #000000;
    padding: 2 4;
}

#setup-inner {
    height: auto;
    padding: 1 0;
}

#setup-banner {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 2;
}

#setup-prompt {
    color: #cccccc;
    text-style: bold;
    margin-bottom: 1;
}

#setup-hint {
    color: #444444;
    margin-bottom: 1;
}

#setup-input {
    width: 100%;
    background: #000000;
    border: solid #1f1f1f;
    color: #ffffff;
    margin-bottom: 1;
}

#setup-input:focus {
    border: solid #333333;
}

#setup-summary {
    color: #888888;
    margin-top: 1;
}

/* ── OUTPUT PANEL ────────────────────────────────────────────────────────── */

OutputPanel {
    height: 1fr;
    background: #000000;
    padding: 1 2;
    overflow-y: auto;
}

.user-msg {
    color: #e6e6e6;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.ai-msg {
    color: #ffffff;
    margin-bottom: 1;
}

.ai-status {
    color: #8a8a8a;
    text-style: bold;
}

.ai-detail {
    color: #4f4f4f;
    margin-bottom: 1;
}

.ai-stream {
    color: #d8d8d8;
    margin-bottom: 1;
}

.ai-body {
    color: #ffffff;
    margin-top: 1;
}

.ai-raw {
    color: #5f5f5f;
    margin-top: 1;
    border-top: solid #1a1a1a;
    padding-top: 1;
}

.system-msg {
    color: #444444;
    margin-bottom: 1;
}

/* ── INPUT BAR ───────────────────────────────────────────────────────────── */

UltraInput {
    dock: bottom;
    height: 7;
    background: #000000;
    border-top: solid #1f1f1f;
}

#cmd-input {
    width: 100%;
    height: 5;
    background: #000000;
    border: none;
    color: #ffffff;
}

#cmd-input:focus {
    border: none;
}
